<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CareFlow.ViewModels"
        x:Class="CareFlow.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="980"
        Height="640">

	<Grid RowDefinitions="Auto,*,Auto" Margin="16">

		<!-- Top Controls: Date & Availability Refresh -->
		<Border Grid.Row="0" Padding="12" Margin="0,0,0,12" CornerRadius="6" BorderBrush="#CCCCCC" BorderThickness="1">
			<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
				<TextBlock Text="Booking / Availability Date:" VerticalAlignment="Center" FontWeight="SemiBold" />
				<DatePicker SelectedDate="{Binding SelectedDate}" />
				<Button Content="Refresh Availability"
                        Command="{Binding RefreshAvailabilityCommand}"
                        IsEnabled="{Binding !IsBusy}" />
			</StackPanel>
		</Border>

		<!-- Main Content: Left = New Booking, Right = Confirmed Bookings -->
		<Grid Grid.Row="1" ColumnDefinitions="*,*">

			<!-- Left Panel: Multi-Service Booking Form -->
			<Border Grid.Column="0" Padding="14" Margin="0,0,7,0" CornerRadius="6" BorderBrush="#CCCCCC" BorderThickness="1">
				<Grid RowDefinitions="Auto,Auto,*,Auto">
					<TextBlock Grid.Row="0" Text="New Diagnostic Booking (1–3 Services)"
                               Margin="0,0,0,10" FontSize="16" FontWeight="Bold" />

					<StackPanel Grid.Row="1" Margin="0,0,0,10" Spacing="4">
						<TextBlock Text="Select Existing Patient:" FontWeight="SemiBold" />
						<ComboBox ItemsSource="{Binding Patients}"
                                  SelectedItem="{Binding SelectedPatient}"
                                  HorizontalAlignment="Stretch">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding FullName}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</StackPanel>

					<ScrollViewer Grid.Row="2" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto">
						<ItemsControl ItemsSource="{Binding ServiceItems}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<CheckBox IsChecked="{Binding IsSelected}"
                                              IsEnabled="{Binding RemainingCapacity}"
                                              Margin="0,4">
										<TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" />
									</CheckBox>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>

					<Button Grid.Row="3"
                            Content="Confirm Booking"
                            Command="{Binding ConfirmBookingCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="10" />
				</Grid>
			</Border>

			<!-- Right Panel: Confirmed Bookings Retrieval -->
			<Border Grid.Column="1" Padding="14" Margin="7,0,0,0" CornerRadius="6" BorderBrush="#CCCCCC" BorderThickness="1">
				<Grid RowDefinitions="Auto,*,Auto">
					<TextBlock Grid.Row="0" Text="Confirmed Bookings"
                               Margin="0,0,0,10" FontSize="16" FontWeight="Bold" />

					<ListBox Grid.Row="1"
                             Margin="0,0,0,10"
                             ItemsSource="{Binding ConfirmedBookings}"
                             SelectedItem="{Binding SelectedConfirmedBooking}">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Border Padding="8" Margin="0,0,0,6" CornerRadius="4"
                                        BorderBrush="#E0E0E0" BorderThickness="1">
									<StackPanel Spacing="2">
										<TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" />
										<TextBlock Text="{Binding BookingDate, StringFormat='Date: {0:yyyy-MM-dd}'}" FontSize="12" />
										<TextBlock Text="{Binding ServicesSummary}" TextWrapping="Wrap" FontSize="12" />
									</StackPanel>
								</Border>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>

					<StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right">
						<Button Content="Cancel Booking"
                                Command="{Binding CancelSelectedBookingCommand}"
                                IsEnabled="{Binding !IsBusy}" />
						<Button Content="Reload Bookings"
                                Command="{Binding LoadConfirmedBookingsCommand}"
                                IsEnabled="{Binding !IsBusy}" />
					</StackPanel>
				</Grid>
			</Border>

		</Grid>

		<!-- Bottom Status / Validation Feedback -->
		<Border Grid.Row="2" Padding="10" Margin="0,12,0,0" CornerRadius="6" Background="#F4F4F4" BorderBrush="#CCCCCC" BorderThickness="1">
			<TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
		</Border>

	</Grid>
</Window>